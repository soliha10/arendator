# ── Ma'lumotlar bazasi ──────────────────────────────────────
# Lokal PostgreSQL (brew services start postgresql@14)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/arendator?schema=public"
# Pooler ishlatilganda (Neon/PgBouncer) migratsiyalar uchun to'g'ridan-to'g'ri ulanish.
# Lokalda DATABASE_URL bilan bir xil.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/arendator?schema=public"

# ── Auth ────────────────────────────────────────────────────
# Ishlab chiqarishda albatta yangilang: openssl rand -base64 32
AUTH_SECRET="openssl rand -base64 32 bilan yarating"

# ── Fayl saqlash ────────────────────────────────────────────
# "local" — public/uploads papkasi (faqat dev uchun)
# "s3"    — S3 mos keluvchi (Cloudflare R2, AWS S3)
STORAGE_DRIVER="local"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""

# ── Ilova ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Docker Compose uchun (docker-compose.yml oʻqiydi) ───────
# POSTGRES_USER="arendator"
# POSTGRES_PASSWORD="kuchli-parol"
# POSTGRES_DB="arendator"
# WEB_PORT="3000"

# ── Brend va aloqa (header, footer, SEO) ────────────────────
# NEXT_PUBLIC_SITE_NAME="Arendator"
# NEXT_PUBLIC_SUPPORT_PHONE="+998712000000"
# NEXT_PUBLIC_SUPPORT_EMAIL="info@arendator.uz"
# NEXT_PUBLIC_SUPPORT_TELEGRAM="arendator_uz"

# ── Reklama va analitika (bo'sh bo'lsa skript yuklanmaydi) ──
# Google Analytics 4: G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=""
# Yandex Metrika hisoblagich raqami
# NEXT_PUBLIC_YM_ID=""
# Meta (Facebook/Instagram) Pixel ID
# NEXT_PUBLIC_META_PIXEL_ID=""
# Search Console / Yandex Webmaster tasdiq kodlari
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_YANDEX_VERIFICATION=""
